    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Brighton & Hove Albion | Pages Of Football</title>

    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="premier.css">
</head>

<body>

<header class="main-header">

    <div class="logo">
        <a href="index.html">PAGES OF FOOTBALL</a>
    </div>

    <nav class="main-nav">
        <a href="index.html">Home</a>
        <a href="teams.html">Squadre</a>
        <a href="players.html">Giocatori</a>
        <a href="stories.html">Storie</a>
    </nav>

    <div class="header-search">
        <a href="#">⌕</a>
