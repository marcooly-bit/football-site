<!-- COACH -->

<section class="team-section coach-section">

    <div class="section-heading">
        <span>04</span>
        <h2>Allenatore</h2>
    </div>

    <div class="coach-card">

        <div class="coach-image">
            <img src="images/coaches/fabian-hurzeler.png"
                 alt="Fabian Hürzeler">
        </div>

        <div class="coach-info">

            <span>HEAD COACH</span>

            <h3>Fabian Hürzeler</h3>

            <p>
                🇩🇪 Germania
            </p>

            <div class="coach-description">

                <p>
                    Fabian Hürzeler guida il Brighton nella stagione 2026/27,
                    alla sua terza stagione sulla panchina dei Seagulls.
                    Arrivato in Inghilterra dopo l'esperienza al St. Pauli,
                    ha costruito una squadra riconoscibile per possesso palla,
                    intensità e valorizzazione dei giovani talenti.
                </p>

            </div>

        </div>

    </div>

</section>


