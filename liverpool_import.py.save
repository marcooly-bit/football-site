mport os
import re
import requests

from bs4 import BeautifulSoup
from dotenv import load_dotenv
from urllib.parse import urljoin


# =========================================================
# CONFIGURAZIONE
# =========================================================

load_dotenv()

BASE_URL = "https://www.liverpoolfc.com"
SQUAD_URL = "https://www.liverpoolfc.com/teams/mens-team"

HEADERS = {
    "User-Agent": "Mozilla/5.0"
}


# =========================================================
# SLUG
# =========================================================

def slugify(name):
    replacements = {
        "á": "a",
        "à": "a",
        "ä": "a",
        "ã": "a",
        "å": "a",

        "é": "e",
        "è": "e",
        "ë": "e",

        "í": "i",
        "ì": "i",
        "ï": "i",

        "ó": "o",
        "ò": "o",
        "ö": "o",
        "õ": "o",

        "ú": "u",
        "ù": "u",
        "ü": "u",

        "ý": "y",
        "ÿ": "y",

        "ñ": "n",
        "ç": "c",
        "š": "s",
        "ž": "z",

        "ć": "c",
        "č": "c",
kì        "đ": "d",
        "ł": "l",
        "ß": "ss",
    }

    name = name.lower()

    for old, new in replacements.items():
        name = name.replace(old, new)

    name = re.sub(r"[^a-z0-9]+", "-", name)

    return name.strip("-")


# =========================================================
# TROVA I PROFILI DEI GIOCATORI
# =========================================================

def get_player_links():

    print("\n1. Leggo la rosa Liverpool 2026/27...")

    response = requests.get(
        SQUAD_URL,
        headers=HEADERS,
        timeout=30
    )

    response.raise_for_status()

    soup = BeautifulSoup(response.text, "html.parser")

    players = {}

    for link in soup.find_all("a", href=True):

        href = link["href"]

        # I profili giocatore Liverpool usano questo percorso
        if not href.startswith("/team/first-team/player/"):
            continue

        full_url = urljoin(BASE_URL, href)

        # Lo slug viene preso direttamente dall'URL
        slug = href.rstrip("/").split("/")[-1]

        # Nome visualizzato, se disponibile
        text = link.get_text(" ", strip=True)

        players[full_url] = {
            "name": text,
            "slug": slug
        }

    return players


# =========================================================
# TROVA LE DUE IMMAGINI
# =========================================================

def get_images(player_url):

    response = requests.get(
        player_url,
        headers=HEADERS,
        timeout=30
    )

    if response.status_code != 200:
        return None, None

    html = response.text

    # Alcuni URL sono codificati come &amp;
    html = html.replace("&amp;", "&")

    # Cerca tutti gli asset Contentful presenti nella pagina
    urls = re.findall(
        r'https://images\.ctfassets\.net/[^"\'<>\\\s]+',
        html
    )

    normal = None
    action = None

    for url in urls:

        clean_url = url.rstrip("\\").rstrip(",")

        lower_url = clean_url.lower()

        # Foto normale/profilo
        if "app-profile" in lower_url:
            normal = clean_url

        # Foto action
        elif "action-shot" in lower_url:
            action = clean_url

    return normal, action


# =========================================================
# AVVIO
# =========================================================

print("=" * 70)
print("LIVERPOOL 2026/27 → RICERCA IMMAGINI")
print("=" * 70)


players = get_player_links()


print()
print(f"Trovati {len(players)} profili giocatore.")
print()
print("Controllo immagini...")
print()


found = 0


for player_url, data in players.items():

    player_name = data["name"]
    slug = data["slug"]

    normal, action = get_images(player_url)

    print("-" * 70)

    print("NOME :", player_name)
    print("SLUG :", slug)
    print("URL  :", player_url)

    if normal:
        print("NORMAL:")
        print(normal)
    else:
        print("NORMAL: NON TROVATA")

    if action:
        print("ACTION:")
        print(action)
    else:
        print("ACTION: NON TROVATA")

    if normal and action:
        found += 1


print()
print("=" * 70)
print(f"Profili con entrambe le immagini: {found}/{len(players)}")
print("=" * 70
