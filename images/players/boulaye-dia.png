.text-secondary { color: var(--color-secondary); }

.text-white { color: rgb(255, 255, 255); }

.fade-enter-active, .fade-leave-active { transition: opacity 0.3s cubic-bez=
ier(0.45, 0, 0.55, 1) 0s; }

.fade-enter-from, .fade-leave-to { opacity: 0; }

.fade-zoom-enter-active, .fade-zoom-leave-active { transition: scale 0.3s c=
ubic-bezier(0.45, 0, 0.55, 1) 0s, opacity; }

.fade-zoom-enter-from, .fade-zoom-leave-to { opacity: 0; scale: 1.05; }

.fade-up-enter-active, .fade-up-leave-active { transition: translate 0.3s c=
ubic-bezier(0.45, 0, 0.55, 1) 0s, opacity; }

.fade-up-enter-from, .fade-up-leave-to { opacity: 0; translate: 0px 100%; }

.fade-left-enter-active, .fade-left-leave-active { transition: translate 0.=
3s cubic-bezier(0.45, 0, 0.55, 1) 0s, opacity; }

.fade-left-enter-from, .fade-left-leave-to { opacity: 0; translate: 5%; }

.fade-right-enter-active, .fade-right-leave-active { transition: translate =
0.3s cubic-bezier(0.45, 0, 0.55, 1) 0s, opacity; }

.fade-right-enter-from, .fade-right-leave-to { opacity: 0; translate: -5%; =
}

.fade-slide-enter-active, .fade-slide-leave-active { transition: translate =
0.5s cubic-bezier(0, 0.35, 0.35, 1) 0s, opacity; }

